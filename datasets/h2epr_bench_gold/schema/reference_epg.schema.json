{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "H2EPR-Bench reference event-process graph schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "public_event_id",
    "canonical_event",
    "scope_boundary",
    "stages",
    "episodes",
    "participants",
    "actions",
    "outcomes",
    "structural_relations",
    "temporal_relations",
    "causal_relations",
    "mechanism_paths",
    "evidence_graph"
  ],
  "properties": {
    "canonical_event": {
      "$ref": "#/$defs/canonical_event"
    },
    "scope_boundary": {
      "$ref": "#/$defs/scope_boundary"
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "episodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/episode"
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/participant"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outcome"
      }
    },
    "structural_relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "temporal_relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "causal_relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "mechanism_paths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mechanism_path"
      }
    },
    "evidence_graph": {
      "$ref": "#/$defs/evidence_graph"
    },
    "public_event_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^H2EPR-[0-9]{4}$"
    }
  },
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "time_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/nullable_string"
        },
        "end": {
          "$ref": "#/$defs/nullable_string"
        },
        "precision": {
          "$ref": "#/$defs/nullable_string"
        },
        "note": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "canonical_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "domain",
        "category"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonempty_string"
        },
        "domain": {
          "$ref": "#/$defs/nonempty_string"
        },
        "category": {
          "$ref": "#/$defs/nonempty_string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "uniqueItems": true
        },
        "event_type": {
          "$ref": "#/$defs/nullable_string"
        },
        "summary": {
          "$ref": "#/$defs/nullable_string"
        },
        "time_range": {
          "$ref": "#/$defs/time_range"
        }
      }
    },
    "scope_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include",
        "exclude"
      ],
      "properties": {
        "include": {
          "$ref": "#/$defs/nonempty_string"
        },
        "exclude": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "sequence_index"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "label": {
          "$ref": "#/$defs/nonempty_string"
        },
        "sequence_index": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "$ref": "#/$defs/nullable_string"
        },
        "time_range": {
          "$ref": "#/$defs/time_range"
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "stage_id",
        "sequence_index"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "label": {
          "$ref": "#/$defs/nonempty_string"
        },
        "stage_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "sequence_index": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "$ref": "#/$defs/nullable_string"
        },
        "time_range": {
          "$ref": "#/$defs/time_range"
        }
      }
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "label": {
          "$ref": "#/$defs/nonempty_string"
        },
        "type": {
          "$ref": "#/$defs/nullable_string"
        },
        "role": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "episode_id",
        "actor_ids",
        "target_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "label": {
          "$ref": "#/$defs/nonempty_string"
        },
        "episode_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "actor_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "uniqueItems": true
        },
        "target_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "uniqueItems": true
        },
        "description": {
          "$ref": "#/$defs/nullable_string"
        },
        "time_range": {
          "$ref": "#/$defs/time_range"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "producer_action_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "label": {
          "$ref": "#/$defs/nonempty_string"
        },
        "producer_action_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "uniqueItems": true
        },
        "episode_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "description": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from_id",
        "to_id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "from_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "to_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "label": {
          "$ref": "#/$defs/nonempty_string"
        },
        "description": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "mechanism_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "node_ids",
        "relation_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "label": {
          "$ref": "#/$defs/nonempty_string"
        },
        "node_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty_string"
          }
        },
        "relation_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty_string"
          }
        }
      }
    },
    "evidence_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "source_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "passage_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "passage_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "support_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "target_type",
        "evidence_ids"
      ],
      "properties": {
        "target_id": {
          "$ref": "#/$defs/nonempty_string"
        },
        "target_type": {
          "$ref": "#/$defs/nonempty_string"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonempty_string"
          },
          "uniqueItems": true
        }
      }
    },
    "evidence_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_nodes",
        "support_edges"
      ],
      "properties": {
        "evidence_nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_node"
          }
        },
        "support_edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/support_edge"
          }
        }
      }
    }
  }
}
